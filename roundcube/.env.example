# Copiar a .env (NUNCA commitear el .env real) y llenar con valores reales.

# ── Base de datos propia de Roundcube (NO Supabase) ─────────────────────
ROUNDCUBE_DB_ROOT_PASSWORD=cambia-esto
ROUNDCUBE_DB_USER=roundcube
ROUNDCUBE_DB_PASSWORD=cambia-esto
ROUNDCUBE_DB_NAME=roundcubemail

# ── Servidor de correo IONOS ─────────────────────────────────────────────
# Default: puerto 993/465 con SSL/TLS directo. Alternativa STARTTLS:
#   ROUNDCUBE_IMAP_HOST=tls://imap.ionos.mx   (puerto sigue 993)
#   ROUNDCUBE_SMTP_HOST=tls://smtp.ionos.mx
#   ROUNDCUBE_SMTP_PORT=587
ROUNDCUBE_IMAP_HOST=ssl://imap.ionos.mx
ROUNDCUBE_IMAP_PORT=993
ROUNDCUBE_SMTP_HOST=ssl://smtp.ionos.mx
ROUNDCUBE_SMTP_PORT=465

# ── Integración con MOVI (Fase 2 en adelante — sin efecto todavía) ──────
# URL del proyecto Supabase de MOVI Digital.
MOVI_SUPABASE_URL=https://qhwvuuyjhcennqccgvse.supabase.co
# Service role key: la usan los plugins propios para llamar a los edge
# functions de MOVI (render-firma, contactos, etc.) — nunca la expongas
# al navegador ni a Roundcube más allá de este contenedor.
MOVI_SUPABASE_SERVICE_ROLE_KEY=cambia-esto
# Secreto compartido SOLO entre el edge function que emite el token de SSO
# y el plugin movi_auth — no es EMAIL_CREDENTIALS_MASTER_KEY, es uno nuevo,
# exclusivo de este flujo. Generar con: openssl rand -base64 32
MOVI_SSO_SHARED_SECRET=cambia-esto
