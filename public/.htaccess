# ---------------------------------------------------------------------------
# MOVI — Apache/Plesk config para el SPA (beta.movi.digital, mutuus.mx y producción)
# ---------------------------------------------------------------------------

Options -MultiViews

# --- 1. Compresión (gzip / brotli) -----------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css \
    text/javascript application/javascript application/x-javascript \
    application/json application/manifest+json image/svg+xml \
    font/ttf font/otf font/woff font/woff2 application/wasm
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css \
    text/javascript application/javascript application/x-javascript \
    application/json application/manifest+json image/svg+xml \
    font/ttf font/otf font/woff font/woff2
</IfModule>

# --- 2. Caché ---------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|woff2|woff|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "(^|/)(index\.html|version\.json|manifest\.webmanifest|push-sw\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  <FilesMatch "push-sw\.js$">
    Header set Service-Worker-Allowed "/"
  </FilesMatch>
</IfModule>

# --- 3. Redirecciones y Fallback del SPA (React Router) ---------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 3a. Redirección 301 de landings.movi.digital/mutuus hacia mutuus.mx
  RewriteCond %{HTTP_HOST} ^(landings\.)?movi\.digital$ [NC]
  RewriteRule ^mutuus(/.*)?$ https://mutuus.mx/ [R=301,L]

  # 3b. Redirección 301 de www.mutuus.mx hacia https://mutuus.mx/
  RewriteCond %{HTTP_HOST} ^www\.mutuus\.mx$ [NC]
  RewriteRule ^(.*)$ https://mutuus.mx/$1 [R=301,L]

  # 3c. Fallback de React Router
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
