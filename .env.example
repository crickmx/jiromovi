# Variables de entorno del frontend (Vite). Copiar a `.env` (NO se versiona).
# OJO: las VITE_* se "hornean" en el build — deben existir cuando Plesk/Netlify
# corren `vite build`, no en tiempo de ejecución.

# Supabase (proyecto MOVI Digital)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# reCAPTCHA v3 — site key del formulario público (/cotizar de seguros.express y
# la captura de leads de la página del asesor). El dominio seguros.express debe
# estar dado de alta en la consola de Google reCAPTCHA para esta key.
VITE_RECAPTCHA_SITE_KEY=TU_RECAPTCHA_SITE_KEY

# Central de Producción / Bonos (solo dominios MOVI, no seguros.express)
VITE_BONOS_URL=https://cp.movi.digital
