# Copiar como .env en el servidor. No versionar el archivo real.
ROUNDCUBE_IMAGE=roundcube/roundcubemail:1.7.2-apache
ROUNDCUBE_BIND_ADDRESS=127.0.0.1
ROUNDCUBE_HTTP_PORT=8080
ROUNDCUBE_REQUEST_PATH=/correo/

ROUNDCUBE_DB_NAME=roundcube
ROUNDCUBE_DB_USER=roundcube
ROUNDCUBE_DB_PASSWORD=CAMBIAR_POR_PASSWORD_ALEATORIO
ROUNDCUBE_DB_ROOT_PASSWORD=CAMBIAR_POR_OTRO_PASSWORD_ALEATORIO

# Debe ser una cadena aleatoria independiente de EMAIL_CREDENTIALS_MASTER_KEY.
ROUNDCUBE_DES_KEY=CAMBIAR_POR_24_CARACTERES_ALEATORIOS
ROUNDCUBE_SSO_SHARED_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_DE_48_BYTES
ROUNDCUBE_SSO_REDEEM_URL=https://SUPABASE_PROJECT.supabase.co/functions/v1/roundcube-sso-redeem

IONOS_IMAP_HOST=ssl://imap.ionos.mx
IONOS_IMAP_PORT=993
IONOS_SMTP_HOST=ssl://smtp.ionos.mx
IONOS_SMTP_PORT=465

ROUNDCUBE_UPLOAD_MAX_FILESIZE=25M
